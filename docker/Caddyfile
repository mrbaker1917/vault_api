# SITE_ADDRESS — set in .env.prod (default: localhost).
# localhost uses Caddy's automatic local certificate.
# A public hostname gets a Let's Encrypt certificate on ports 80 and 443.
# HSTS is sent only for public hostnames.

{$SITE_ADDRESS} {
	@publicHost not host localhost 127.0.0.1
	header @publicHost Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# /metrics stays on the app container (http://app:8080/metrics) inside the Docker network.
	@backend path /api/* /health /ready
	handle @backend {
		reverse_proxy app:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
