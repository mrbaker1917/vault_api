# Copy to .env.prod and fill in before:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up --build

POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-to-at-least-32-characters-long
PURGE_RETENTION_DAYS=30

# Hostname Caddy listens on (https://SITE_ADDRESS).
# localhost: local certificate, no HSTS. A public domain: Let's Encrypt + HSTS.
SITE_ADDRESS=localhost

# Optional — only if the web app calls a different API origin than the page URL.
# Leave empty for same-origin deploy (recommended; Caddy serves UI + proxies /api/*).
# VITE_API_URL=

# Optional override; defaults to https://SITE_ADDRESS when unset.
# CORS_ALLOWED_ORIGINS=https://localhost
